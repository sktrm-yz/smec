{
  "name": "smec",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun scripts/prerender.tsx",
    "preview": "wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:migrate:local": "wrangler d1 migrations apply smec-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply smec-db --remote",
    "db:seed:local": "wrangler d1 execute smec-db --local --file ./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute smec-db --remote --file ./seed/seed.sql"
  },
  "dependencies": {
    "@humation/assets-humation-1": "^1.0.1",
    "@humation/core": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.8.0",
    "lucide-react": "^1.31.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.0",
    "@cloudflare/workers-types": "^4.20250801.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.28.0"
  }
}
